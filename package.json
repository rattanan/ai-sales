{
  "name": "insightkm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "bash scripts/dev-local.sh",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:dev": "tsx apps/worker/main.ts",
    "worker:watch": "tsx watch apps/worker/main.ts",
    "worker:start": "node dist-worker/apps/worker/main.js",
    "worker:health": "tsx apps/worker/health.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:security-headers": "node scripts/security/check-headers.mjs",
    "test:load": "node scripts/load/phase8-load.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "ops:backup": "sh scripts/operations/backup.sh",
    "ops:restore-drill": "sh scripts/operations/restore-drill.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.4.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-slot": "^1.3.0",
    "ajv": "^8.20.0",
    "bullmq": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.1",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.0",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "node-sql-parser": "^5.4.0",
    "oracledb": "^6.9.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.9.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/oracledb": "^7.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

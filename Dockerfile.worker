FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json tsconfig.json tsconfig.worker.json ./
COPY apps/worker ./apps/worker
COPY packages/ai ./packages/ai
COPY packages/insights ./packages/insights
COPY packages/queue ./packages/queue
COPY packages/knowledge ./packages/knowledge
COPY packages/operations ./packages/operations
COPY schemas/worker-env.ts ./schemas/worker-env.ts
RUN npm run worker:build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 insightkm && adduser --system --uid 1001 worker
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
# Runtime invokes the compiled Worker with Node directly; package-manager
# tooling is build-only and should not expand the production attack surface.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/yarn
COPY --from=builder --chown=worker:insightkm /app/dist-worker ./dist-worker
RUN mkdir -p /app/.data/uploads && chown -R worker:insightkm /app/.data
USER worker
CMD ["node", "dist-worker/apps/worker/main.js"]

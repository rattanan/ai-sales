generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  DASHBOARD_DESIGNER
  ANALYST
  VIEWER
}

enum DataSourceType {
  MYSQL
  POSTGRESQL
  MSSQL
  ORACLE
  EXCEL
}

enum DataSourceStatus {
  DRAFT
  TESTING
  CONNECTED
  FAILED
  DISABLED
}

enum DashboardStatus {
  DRAFT
  ANALYZING
  GENERATED
  PUBLISHED
  ARCHIVED
}

enum DashboardLayout {
  EXECUTIVE_OVERVIEW
  OPERATIONAL_MONITORING
  ANALYTICAL_EXPLORER
  CONTROL_CENTER
  CUSTOM
}

enum DashboardVisualStyle {
  CLEAN_PROFESSIONAL
  MODERN_ENTERPRISE
  MINIMAL_LIGHT
  DARK_CONTROL_ROOM
  DATA_DENSE
}

enum DashboardTheme {
  BLUE
  EMERALD
  AMBER
  SLATE
  CUSTOM
}

enum WidgetType {
  KPI
  STAT
  BAR_CHART
  HORIZONTAL_BAR_CHART
  STACKED_BAR_CHART
  COMBO_CHART
  LINE_CHART
  AREA_CHART
  PIE_CHART
  DONUT_CHART
  SCATTER_CHART
  SCATTER_PLOT
  GAUGE
  BULLET_CHART
  PROGRESS_RING
  FUNNEL_CHART
  WATERFALL_CHART
  RADAR_CHART
  TREEMAP
  HEATMAP
  TIMELINE
  GANTT_CHART
  SANKEY_DIAGRAM
  MAP
  TABLE
  ALERT_LIST
  AI_INSIGHT
  TEXT_INSIGHT
  FILTER
}

enum AnalysisJobStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum AnalysisStage {
  PREPARING_METADATA
  ANALYZING_SCHEMA
  IDENTIFYING_BUSINESS_ENTITIES
  RECOMMENDING_KPIS
  GENERATING_QUERIES
  VALIDATING_QUERIES
  EXECUTING_QUERIES
  GENERATING_WIDGETS
  GENERATING_INSIGHTS
  FINALIZING_DASHBOARD
}

enum AnalysisArtifactType {
  METADATA_CONTEXT
  SCHEMA_ANALYSIS
  KPI_RECOMMENDATIONS
  DASHBOARD_PLAN
  WIDGET_DEFINITIONS
  GENERATED_INSIGHTS
}

enum AnalysisRecommendationType {
  KPI
  WIDGET
}

enum AnalysisRecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum QueryValidationStatus {
  PROPOSED
  VALID
  INVALID
}

enum QueryExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum DatabaseQueryStatus {
  CLARIFICATION_REQUIRED
  READY_FOR_REVIEW
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
}

enum DatabaseQueryIntent {
  DATABASE
  DOCUMENT
  CLARIFICATION
}

enum MetadataRefreshStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum LegacyApiAuthType {
  NONE
  API_KEY
  QUERY_API_KEY
  BEARER
  BASIC
  CUSTOM_HEADER
}

enum LegacyApiHttpMethod {
  GET
  POST
}

enum LegacyApiInvocationStatus {
  CLARIFICATION_REQUIRED
  EXECUTING
  COMPLETED
  FAILED
}

enum UserMemoryCategory {
  PREFERENCE
  DEPARTMENT
  PROJECT
}

enum MemoryConsentStatus {
  GRANTED
  REVOKED
}

enum BusinessInsightJobStatus {
  PROCESSING
  COMPLETED
  INSUFFICIENT_DATA
  FAILED
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  DISABLED
}

enum DashboardAccessLevel {
  OWNER
  EDITOR
  VIEWER
  AI_ANALYST
}

enum ExcelImportStatus {
  PROCESSING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum LoginEventStatus {
  SUCCESS
  FAILED
  LOCKED
  LOGOUT
}

enum BotAccessLevel {
  USE
  MANAGE
}

enum KnowledgeAccessLevel {
  READ
  UPLOAD
  MANAGE
}

enum DocumentVersionStatus {
  UPLOADED
  QUEUED
  PROCESSING
  INDEXED
  FAILED
  CANCELLED
}

enum IndexJobStatus {
  QUEUED
  PROCESSING
  CANCEL_REQUESTED
  CANCELLED
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum KnowledgeSourceType {
  FILE
  SHARED_FOLDER
  WEB
  COPIED_TEXT
}

enum SourceScope {
  GLOBAL
  SELECTED_BOTS
}

enum EnterpriseSourceStatus {
  DRAFT
  TESTING
  PROCESSING
  READY
  FAILED
  NEEDS_REINDEX
  DISABLED
}

enum AiEndpointKind {
  CHAT
  EMBEDDING
}

enum AiEndpointProviderType {
  OPENAI_COMPATIBLE
  OLLAMA
}

enum ChatScope {
  SMART
  ALL_ACCESSIBLE
  SPECIFIC_BOT
  SPECIFIC_SOURCES
  DOCUMENTS
  DATABASES
  API_TOOLS
  CONVERSATION_HISTORY
  BUSINESS_INSIGHT
}

enum ChatMode {
  AUTO
  ASK
  SEARCH
  ANALYZE
  SUMMARIZE
  GENERATE_REPORT
  QUERY_LIVE_DATA
}

enum ToolTraceStatus {
  SELECTED
  EXECUTING
  COMPLETED
  FAILED
}

enum SourceRefreshStatus {
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum SourceRefreshTrigger {
  MANUAL
  SCHEDULED
}

enum SourceSnapshotStatus {
  ACTIVE
  DELETED
  ERROR
}

enum IndexFailureCategory {
  PARSER
  EMBEDDING
  STORAGE
  QUEUE
  CANCELLED
  UNKNOWN
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AuthenticationMode {
  EMBEDDED
  EXTERNAL_API
  LOCAL
}

enum EmbeddedSignatureMode {
  HMAC_SHA256
  JWT_HS256
  BOTH
}

enum ExternalAuthMethod {
  GET
  POST
  PUT
}

enum ResourceType {
  BOT
  KNOWLEDGE_RACK
  KNOWLEDGE_SOURCE
  DOCUMENT
  DATA_SOURCE
  DATABASE_SCHEMA
  DATABASE_TABLE
  LEGACY_API
  CHAT
  INSIGHT
}

enum ResourceAccessEffect {
  ALLOW
  DENY
}

enum ResourceAccessLevel {
  VIEW
  USE
  EDIT
  MANAGE
}

model User {
  id                        String                   @id @default(cuid())
  name                      String?
  email                     String                   @unique
  emailVerified             DateTime?
  image                     String?
  passwordHash              String?
  username                  String?                  @unique
  status                    AccountStatus            @default(PENDING_ACTIVATION)
  mustChangePassword        Boolean                  @default(false)
  isShadow                  Boolean                  @default(false)
  failedLoginCount          Int                      @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  sessionVersion            Int                      @default(1)
  createdById               String?
  deletedAt                 DateTime?
  createdBy                 User?                    @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers              User[]                   @relation("UserCreator")
  accounts                  Account[]
  sessions                  Session[]
  memberships               OrganizationMember[]
  workspaces                Workspace[]              @relation("WorkspaceCreator")
  dataSources               DataSource[]             @relation("DataSourceCreator")
  dashboards                Dashboard[]              @relation("DashboardCreator")
  auditLogs                 AuditLog[]               @relation("AuditActor")
  analysisJobs              AnalysisJob[]            @relation("AnalysisRequestedBy")
  analysisReviews           AnalysisRecommendation[] @relation("AnalysisReviewedBy")
  userRoles                 UserRole[]
  dataSourceAccess          DataSourceAccess[]
  dashboardAccess           DashboardAccess[]
  aiAccessPolicies          AIAccessPolicy[]
  aiCopilotLogs             AiCopilotLog[]
  passwordResets            PasswordResetToken[]
  loginHistory              LoginHistory[]
  uploadedExcelVersions     ExcelFileVersion[]       @relation("ExcelVersionUploader")
  createdBots               Bot[]                    @relation("BotCreator")
  botAccess                 BotAccess[]
  createdKnowledgeRacks     KnowledgeRack[]          @relation("KnowledgeRackCreator")
  knowledgeRackAccess       KnowledgeRackAccess[]
  uploadedDocuments         Document[]               @relation("DocumentCreator")
  uploadedDocumentVersions  DocumentVersion[]        @relation("DocumentVersionUploader")
  conversations             Conversation[]
  chatFeedback              ChatMessageFeedback[]
  externalIdentities        ExternalIdentity[]
  externalSessions          ExternalSession[]
  resourceAcl               ResourceAcl[]
  requestedDatabaseQueries  DatabaseQuery[]          @relation("DatabaseQueryRequester")
  approvedDatabaseQueries   DatabaseQuery[]          @relation("DatabaseQueryApprover")
  createdLegacyApis         LegacyApi[]              @relation("LegacyApiCreator")
  requestedApiInvocations   LegacyApiInvocation[]    @relation("LegacyApiInvocationRequester")
  memories                  UserMemory[]             @relation("MemoryOwner")
  memoryConsents            MemoryConsent[]          @relation("MemoryConsentOwner")
  changedMemoryConsents     MemoryConsent[]          @relation("MemoryConsentActor")
  requestedBusinessInsights BusinessInsightJob[]     @relation("BusinessInsightRequester")
  createdKnowledgeSources   KnowledgeSource[]        @relation("KnowledgeSourceCreator")
  createdAiEndpoints        AiEndpointConfig[]       @relation("AiEndpointCreator")
  assignedKnowledgeGaps     KnowledgeGap[]           @relation("KnowledgeGapAssignee")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([status, deletedAt])
  @@index([createdById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                   String                 @id @default(cuid())
  name                 String
  slug                 String                 @unique
  members              OrganizationMember[]
  workspaces           Workspace[]
  auditLogs            AuditLog[]
  analysisJobs         AnalysisJob[]
  roles                Role[]
  userRoles            UserRole[]
  dataSourceAccess     DataSourceAccess[]
  dashboardAccess      DashboardAccess[]
  aiAccessPolicies     AIAccessPolicy[]
  loginHistory         LoginHistory[]
  aiCopilotLogs        AiCopilotLog[]
  organizationUnits    OrganizationUnit[]
  projects             OrganizationProject[]
  llmProviders         LlmProvider[]
  piiMaskingPolicy     PiiMaskingPolicy?
  retentionPolicy      SystemRetentionPolicy?
  bots                 Bot[]
  botAccess            BotAccess[]
  knowledgeRacks       KnowledgeRack[]
  knowledgeRackAccess  KnowledgeRackAccess[]
  documents            Document[]
  conversations        Conversation[]
  authenticationPolicy AuthenticationPolicy?
  externalIdentities   ExternalIdentity[]
  externalSessions     ExternalSession[]
  resourceAcl          ResourceAcl[]
  databaseQueries      DatabaseQuery[]
  legacyApis           LegacyApi[]
  legacyApiInvocations LegacyApiInvocation[]
  userMemories         UserMemory[]
  memoryConsents       MemoryConsent[]
  businessInsightJobs  BusinessInsightJob[]
  aiEndpoints          AiEndpointConfig[]
  knowledgeGaps        KnowledgeGap[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model OrganizationMember {
  id                 String            @id @default(cuid())
  organizationId     String
  userId             String
  role               OrganizationRole  @default(VIEWER)
  organizationUnitId String?
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: SetNull)
  projects           UserProject[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, organizationUnitId])
}

model OrganizationUnit {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  active         Boolean              @default(true)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  conversations  Conversation[]
  insightJobs    BusinessInsightJob[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model OrganizationProject {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  active         Boolean              @default(true)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        UserProject[]
  conversations  Conversation[]
  insightJobs    BusinessInsightJob[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model UserProject {
  id                   String              @id @default(cuid())
  organizationMemberId String
  projectId            String
  organizationMember   OrganizationMember  @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  project              OrganizationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())

  @@unique([organizationMemberId, projectId])
  @@index([projectId])
}

model LlmProvider {
  id                        String                 @id @default(cuid())
  organizationId            String
  name                      String
  providerType              String                 @default("openai-compatible")
  baseUrl                   String
  chatModel                 String
  embeddingModel            String
  temperature               Float                  @default(0.1)
  timeoutMs                 Int                    @default(30000)
  maxTokens                 Int                    @default(4096)
  active                    Boolean                @default(false)
  supportsJsonSchema        Boolean                @default(true)
  fallbackEnabled           Boolean                @default(false)
  lastHealthStatus          String                 @default("UNKNOWN")
  lastChatHealthStatus      String                 @default("UNKNOWN")
  lastEmbeddingHealthStatus String                 @default("UNKNOWN")
  lastHealthMessage         String?
  lastChatLatencyMs         Int?
  lastEmbeddingLatencyMs    Int?
  lastTestedAt              DateTime?
  organization              Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential                LlmProviderCredential?
  botConfigurations         BotProviderConfig[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model LlmProviderCredential {
  id         String      @id @default(cuid())
  providerId String      @unique
  ciphertext String
  iv         String
  authTag    String
  keyVersion String
  provider   LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model PiiMaskingPolicy {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  enabled                Boolean      @default(true)
  maskEmail              Boolean      @default(true)
  maskPhone              Boolean      @default(true)
  maskNationalId         Boolean      @default(true)
  maskFinancialAccount   Boolean      @default(true)
  maskPassport           Boolean      @default(true)
  maskHealth             Boolean      @default(true)
  maskReligion           Boolean      @default(true)
  maskBiometric          Boolean      @default(true)
  allowSensitiveAiAccess Boolean      @default(false)
  customPatterns         Json?
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model SystemRetentionPolicy {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  auditLogDays        Int          @default(365)
  loginHistoryDays    Int          @default(180)
  chatHistoryDays     Int          @default(90)
  memoryRetentionDays Int          @default(365)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model AuthenticationPolicy {
  id                 String              @id @default(cuid())
  organizationId     String              @unique
  localEnabled       Boolean             @default(true)
  externalApiEnabled Boolean             @default(false)
  embeddedEnabled    Boolean             @default(false)
  modePriority       Json                @default("[\"EMBEDDED\",\"EXTERNAL_API\",\"LOCAL\"]")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  embeddedConfig     EmbeddedAuthConfig?
  externalApiConfig  ExternalAuthConfig?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model EmbeddedAuthConfig {
  id                  String                @id @default(cuid())
  policyId            String                @unique
  keyId               String                @unique
  signatureMode       EmbeddedSignatureMode @default(BOTH)
  allowedOrigins      String[]              @default([])
  replayWindowSeconds Int                   @default(300)
  sessionTtlSeconds   Int                   @default(28800)
  active              Boolean               @default(true)
  ciphertext          String
  iv                  String
  authTag             String
  keyVersion          String
  lastRotatedAt       DateTime              @default(now())
  policy              AuthenticationPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  nonces              EmbeddedAuthNonce[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model ExternalAuthConfig {
  id                  String                  @id @default(cuid())
  policyId            String                  @unique
  url                 String
  method              ExternalAuthMethod      @default(POST)
  headers             Json?
  requestMapping      Json
  responseMapping     Json
  timeoutMs           Int                     @default(10000)
  active              Boolean                 @default(false)
  lastHealthStatus    String?
  lastHealthMessage   String?
  lastHealthLatencyMs Int?
  lastTestedAt        DateTime?
  policy              AuthenticationPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  credential          ExternalAuthCredential?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model ExternalAuthCredential {
  id         String             @id @default(cuid())
  configId   String             @unique
  headerName String
  ciphertext String
  iv         String
  authTag    String
  keyVersion String
  config     ExternalAuthConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model EmbeddedAuthNonce {
  id         String             @id @default(cuid())
  configId   String
  nonceHash  String
  expiresAt  DateTime
  consumedAt DateTime           @default(now())
  config     EmbeddedAuthConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@unique([configId, nonceHash])
  @@index([expiresAt])
}

model ExternalIdentity {
  id                    String             @id @default(cuid())
  organizationId        String
  userId                String
  mode                  AuthenticationMode
  externalUserId        String
  externalUsername      String?
  lastExternalSessionId String?
  metadata              Json?
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([organizationId, mode, externalUserId])
  @@index([userId, organizationId])
}

model ExternalSession {
  id                String             @id @default(cuid())
  organizationId    String
  botId             String
  userId            String
  conversationId    String?
  authMode          AuthenticationMode
  externalSessionId String
  origin            String
  tokenHash         String             @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  lastSeenAt        DateTime           @default(now())
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bot               Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([organizationId, botId, externalSessionId])
  @@index([organizationId, userId, botId])
  @@index([expiresAt, revokedAt])
}

model Bot {
  id                   String                @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  avatarUrl            String?
  systemPrompt         String
  welcomeMessage       String
  suggestedQuestions   Json?
  active               Boolean               @default(false)
  fallbackMessage      String?
  apiToolsEnabled      Boolean               @default(true)
  databaseToolsEnabled Boolean               @default(true)
  primaryColor         String                @default("#4f46e5")
  headerColor          String                @default("#111827")
  chatBubbleColor      String                @default("#eef2ff")
  fontFamily           String                @default("system")
  colorMode            String                @default("LIGHT")
  launcherIcon         String?
  widgetSize           String                @default("STANDARD")
  launcherSize         Int                   @default(56)
  windowPosition       String                @default("RIGHT")
  placeholder          String                @default("Ask a question…")
  brandingEnabled      Boolean               @default(true)
  currentVersion       Int                   @default(1)
  createdById          String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy            User                  @relation("BotCreator", fields: [createdById], references: [id])
  versions             BotVersion[]
  access               BotAccess[]
  knowledgeRacks       BotKnowledgeRack[]
  knowledgeSources     BotKnowledgeSource[]
  dataSources          BotDataSource[]
  providerConfig       BotProviderConfig?
  conversations        Conversation[]
  externalSessions     ExternalSession[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  databaseQueries      DatabaseQuery[]
  legacyApis           BotLegacyApi[]
  legacyApiInvocations LegacyApiInvocation[]
  memories             UserMemory[]
  memoryConsents       MemoryConsent[]
  businessInsightJobs  BusinessInsightJob[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model BotVersion {
  id            String   @id @default(cuid())
  botId         String
  version       Int
  configuration Json
  createdById   String
  bot           Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([botId, version])
  @@index([botId, createdAt])
}

model BotAccess {
  id             String         @id @default(cuid())
  organizationId String
  botId          String
  userId         String?
  roleId         String?
  level          BotAccessLevel @default(USE)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bot            Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role?          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([botId, userId])
  @@unique([botId, roleId])
  @@index([organizationId, userId])
  @@index([organizationId, roleId])
}

model BotProviderConfig {
  id              String            @id @default(cuid())
  botId           String            @unique
  providerId      String?
  chatEndpointId  String?
  model           String?
  temperature     Float             @default(0.1)
  maxTokens       Int               @default(2048)
  contextSize     Int               @default(12000)
  citationEnabled Boolean           @default(true)
  memoryMode      String            @default("CONVERSATION")
  bot             Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  provider        LlmProvider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  chatEndpoint    AiEndpointConfig? @relation(fields: [chatEndpointId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([providerId])
  @@index([chatEndpointId])
}

model BotKnowledgeRack {
  botId     String
  rackId    String
  bot       Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  rack      KnowledgeRack @relation(fields: [rackId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([botId, rackId])
  @@index([rackId])
}

model BotDataSource {
  botId        String
  dataSourceId String
  enabled      Boolean    @default(true)
  priority     Int        @default(100)
  bot          Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([botId, dataSourceId])
  @@index([dataSourceId])
}

model BotLegacyApi {
  botId       String
  legacyApiId String
